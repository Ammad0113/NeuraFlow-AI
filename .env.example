# NeuraFlow AI Configuration

PROJECT_NAME="NeuraFlow AI"
ENVIRONMENT="development"
SECRET_KEY="neuraflow-super-secret-jwt-key-enterprise-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./neuraflow.db"

# Storage Paths
UPLOAD_DIR="./storage/uploads"
MODEL_DIR="./storage/models"
REPORT_DIR="./storage/reports"

# Optional External AI API Key (if provided, otherwise local AI fallback is used)
OPENAI_API_KEY=""
OPENAI_API_BASE="https://api.openai.com/v1"
OPENAI_MODEL="gpt-3.5-turbo"
